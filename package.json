{
  "name": "greendream-app",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"node server/index.js\" \"vite --host 0.0.0.0 --port 5173\"",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "server": "node server/index.js",
    "build": "tsc && vite build",
    "test": "node scripts/run_all_tests.mjs",
    "knip": "knip",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "build:apk": "npm run build && npx cap sync android"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^8.6.0",
    "capacitor-voice-recorder": "^7.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "knip": "^5.88.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
